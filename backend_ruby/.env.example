# Ruby backend configuration — copy to `.env` and adjust as needed.
# Every value is optional; the defaults below are used when unset.
# Mirrors backend/.env.example so both backends can share a cache directory.

# Where StatsBomb JSON and aggregated caches are stored.
COACH_CACHE_DIR=~/.cache/coachanalyst-statsbomb

# Durable job queue (Redis). Omit to fall back to an in-process job.
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_NAME=coachanalyst

# Matches analysed per competition season (keeps builds snappy).
MAX_MATCHES_PER_COMPETITION=24

# Warm popular-league caches on API startup (1/0). (Enqueued on first request.)
AUTO_WARMUP=0
